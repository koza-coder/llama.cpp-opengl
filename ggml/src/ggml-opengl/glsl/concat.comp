#include "common.glsl"

// Port of the D3D11 concat.hlsl. CONCAT of two 4-byte tensors (f32 or i32, copied as raw bits) along dim; any strides

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src0 { uint src0[]; };
layout(std430, binding = 1) buffer Src1 { uint src1[]; };
layout(std430, binding = 2) buffer Dst  { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src0;
    uint offset_src1;
    uint offset_dst;

    uint stride_src00;
    uint stride_src01;
    uint stride_src02;
    uint stride_src03;
    uint stride_src10;
    uint stride_src11;
    uint stride_src12;
    uint stride_src13;
    uint stride_dst0;
    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint ne;
    uint ne0;
    uint ne1;
    uint ne2;

    uint dim;
    uint src0_nedim;   // src0->ne[dim]

    uint nwg_x;
};

void main() {
    uint i = flat_index(gl_GlobalInvocationID, nwg_x);
    if (i >= ne) {
        return;
    }
    uint idx[4];
    idx[3] = i / (ne2 * ne1 * ne0);
    i = i % (ne2 * ne1 * ne0);
    idx[2] = i / (ne1 * ne0);
    i = i % (ne1 * ne0);
    idx[1] = i / ne0;
    idx[0] = i % ne0;

    const uint i_dst = offset_dst + idx[0] * stride_dst0 + idx[1] * stride_dst1 + idx[2] * stride_dst2 + idx[3] * stride_dst3;
    uint bits;
    if (idx[dim] < src0_nedim) {
        bits = src0[offset_src0 + idx[0] * stride_src00 + idx[1] * stride_src01 + idx[2] * stride_src02 + idx[3] * stride_src03];
    } else {
        idx[dim] -= src0_nedim;
        bits = src1[offset_src1 + idx[0] * stride_src10 + idx[1] * stride_src11 + idx[2] * stride_src12 + idx[3] * stride_src13];
    }
    dst[i_dst] = bits;
}
