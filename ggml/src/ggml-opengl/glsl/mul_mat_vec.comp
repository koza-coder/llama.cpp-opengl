#include "common.glsl"

// Port of the D3D11 mul_mat_vec.hlsl (and its dequant_row.hlsli for the quant types), one matrix per
// dispatch, no fused add:
// dst[row, col] = sum_k src0[row, k] * src1[col, k] for up to MAX_COLS columns per dispatch.
// A workgroup handles ROWS = WG_SIZE / TPR rows: TPR threads share one row and stride over k in units of
// 4 elements for float types, one block or sub-block of 32 for quant types. The reduction is a
// shared-memory tree inside each TPR block, so it does not depend on the subgroup size.
// defines: SRC0_{F32,F16,Q4_0,Q8_0,Q4_K,Q6_K}, TPR (power of two, 1..WG_SIZE), SRC1_F16 (f16 columns instead of f32)
// src0 offsets/strides are in elements for float types and in blocks for quant types.

#define MAX_COLS 4

#define ROWS (WG_SIZE / TPR)

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src1 { uint src1[]; };
layout(std430, binding = 1) buffer Src0 { uint src0[]; };
layout(std430, binding = 2) buffer Dst  { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src1;
    uint n;
    uint k;
    uint stride_11;
    uint stride_12;
    uint stride_13;
    uint bs02;
    uint bs03;
    uint broadcast2;
    uint broadcast3;
    uint col0;        // first column of this chunk; a dispatch covers columns col0 .. col0 + MAX_COLS - 1
    uint offset_src0;
    uint offset_dst;
    uint m;
    uint stride_01;
    uint stride_02;
    uint stride_03;
    uint nwg_x;
};

#if TPR > 1
shared float partial[MAX_COLS][WG_SIZE];
#endif

#if defined(SRC1_F16)
float load_src1(uint i) {
    uint bits;
    LOAD_U16_UNALIGNED(src1, i * 2u, bits);
    return f16_to_f32(bits);
}
#else
float load_src1(uint i) {
    return LOAD_F32(src1, i);
}
#endif

// byte b (0..3) of a word
#define BYTE_OF(q, b) (((q) >> ((b) * 8u)) & 0xFFu)
// byte b (0..3) of a word as a sign-extended int8
#define SBYTE_OF(q, b) bitfieldExtract(int(q), int((b) * 8u), 8)

// accumulate one dequantized value of src0 against every active column of src1
#define ACC(a, kidx) { \
    for (uint _c = 0u; _c < uint(MAX_COLS); _c++) { \
        if (_c < ncols) { acc[_c] += (a) * load_src1(src1_base[_c] + (kidx)); } \
    } \
}

void main() {
    uint tid       = gl_LocalInvocationID.x;
    uint lane      = tid % uint(TPR);
    uint wg_linear = gl_WorkGroupID.y * nwg_x + gl_WorkGroupID.x;

    uint row_groups = (m + uint(ROWS) - 1u) / uint(ROWS);
    uint row        = (wg_linear % row_groups) * uint(ROWS) + tid / uint(TPR);
    uint batch      = wg_linear / row_groups;
    uint batches2   = bs02 * broadcast2;
    // the 2D fold can overshoot the batch count; those workgroups compute nothing and store nothing. They
    // do not return early: GLSL 4.30 does not allow a barrier after a return.
    bool wg_ok      = batch < batches2 * bs03 * broadcast3;
    if (!wg_ok) {
        batch = 0u;
    }
    uint dst2_idx  = batch % batches2;
    uint dst3_idx  = batch / batches2;
    uint src02_idx = dst2_idx / broadcast2;
    uint src03_idx = dst3_idx / broadcast3;

    uint ncols     = min(uint(MAX_COLS), n - col0);
    uint src0_base = offset_src0 + src03_idx * stride_03 + src02_idx * stride_02 + row * stride_01;
    uint src1_base[MAX_COLS];
    for (uint c = 0u; c < uint(MAX_COLS); c++) {
        src1_base[c] = offset_src1 + dst3_idx * stride_13 + dst2_idx * stride_12 + (col0 + c) * stride_11;
    }
    float acc[MAX_COLS];
    for (uint c = 0u; c < uint(MAX_COLS); c++) {
        acc[c] = 0.0;
    }

    if (wg_ok && row < m) {
#if defined(SRC0_Q4_0)
        // block (18 bytes): f16 d, 16 bytes of nibbles; low nibbles are elements 0..15, high nibbles 16..31
        for (uint blk = lane; blk < k / 32u; blk += uint(TPR)) {
            uint base = (src0_base + blk) * 18u;
            uint dbits;
            LOAD_U16_UNALIGNED(src0, base, dbits);
            float d = f16_to_f32(dbits);
            for (uint j = 0u; j < 4u; j++) {
                uint q;
                LOAD_U32_UNALIGNED(src0, base + 2u + 4u * j, q);
                for (uint b = 0u; b < 4u; b++) {
                    uint byte_v = BYTE_OF(q, b);
                    ACC((float(byte_v & 0xFu) - 8.0) * d, blk * 32u + j * 4u + b);
                    ACC((float(byte_v >> 4) - 8.0) * d, blk * 32u + 16u + j * 4u + b);
                }
            }
        }
#elif defined(SRC0_Q8_0)
        // block (34 bytes): f16 d, 32 int8
        for (uint blk = lane; blk < k / 32u; blk += uint(TPR)) {
            uint base = (src0_base + blk) * 34u;
            uint dbits;
            LOAD_U16_UNALIGNED(src0, base, dbits);
            float d = f16_to_f32(dbits);
            for (uint j = 0u; j < 8u; j++) {
                uint q;
                LOAD_U32_UNALIGNED(src0, base + 2u + 4u * j, q);
                for (uint b = 0u; b < 4u; b++) {
                    ACC(float(SBYTE_OF(q, b)) * d, blk * 32u + j * 4u + b);
                }
            }
        }
#elif defined(SRC0_Q4_K)
        // super-block of 256 (144 bytes): f16 d, f16 dmin, 12 bytes of 6-bit scales/mins, 128 bytes of
        // nibbles. Sub-block s (32 values): pair s/2 uses bytes 16 + 32*(s/2), low nibbles for even s, high
        // for odd s. Scales/mins unpacked as get_scale_min_k4 in ggml-quants.c.
        for (uint sb = lane; sb < k / 32u; sb += uint(TPR)) {
            uint blk  = sb / 8u;
            uint s    = sb % 8u;
            uint base = (src0_base + blk) * 144u;
            uint w;
            LOAD_U32_UNALIGNED(src0, base, w);
            float d    = f16_to_f32(w);
            float dmin = f16_to_f32(w >> 16);
            uint sc0, sc1, sc2;
            LOAD_U32_UNALIGNED(src0, base + 4u, sc0);
            LOAD_U32_UNALIGNED(src0, base + 8u, sc1);
            LOAD_U32_UNALIGNED(src0, base + 12u, sc2);
            uint sc, mn;
            if (s < 4u) {
                sc = BYTE_OF(sc0, s) & 63u;
                mn = BYTE_OF(sc1, s) & 63u;
            } else {
                sc = (BYTE_OF(sc2, s - 4u) & 0xFu) | ((BYTE_OF(sc0, s - 4u) >> 6) << 4);
                mn = (BYTE_OF(sc2, s - 4u) >> 4) | ((BYTE_OF(sc1, s - 4u) >> 6) << 4);
            }
            float dl    = d * float(sc);
            float ml    = dmin * float(mn);
            uint  shift = (s & 1u) * 4u;
            uint  qbase = base + 16u + 32u * (s / 2u);
            for (uint j = 0u; j < 8u; j++) {
                uint q;
                LOAD_U32_UNALIGNED(src0, qbase + 4u * j, q);
                for (uint b = 0u; b < 4u; b++) {
                    float v = dl * float((BYTE_OF(q, b) >> shift) & 0xFu) - ml;
                    ACC(v, blk * 256u + s * 32u + j * 4u + b);
                }
            }
        }
#elif defined(SRC0_Q6_K)
        // super-block of 256 (210 bytes): 128 bytes ql, 64 bytes qh, 16 int8 scales, f16 d.
        // Sub-block s: half h = s/4 (128 values), t = s%4 selects the quarter inside the half.
        for (uint sb = lane; sb < k / 32u; sb += uint(TPR)) {
            uint blk  = sb / 8u;
            uint s    = sb % 8u;
            uint h    = s / 4u;
            uint t    = s % 4u;
            uint base = (src0_base + blk) * 210u;
            uint dbits;
            LOAD_U16_UNALIGNED(src0, base + 208u, dbits);
            float d       = f16_to_f32(dbits);
            uint  ql_base = base + 64u * h + 32u * (t & 1u);
            uint  qh_base = base + 128u + 32u * h;
            uint  sc_base = base + 192u + 8u * h + 2u * t;
            uint  lshift  = (t >> 1) * 4u;
            uint  hshift  = t * 2u;
            uint scw;
            LOAD_U32_UNALIGNED(src0, sc_base, scw);
            float d0 = d * float(SBYTE_OF(scw, 0u));
            float d1 = d * float(SBYTE_OF(scw, 1u));
            for (uint j = 0u; j < 8u; j++) {
                uint ql, qh;
                LOAD_U32_UNALIGNED(src0, ql_base + 4u * j, ql);
                LOAD_U32_UNALIGNED(src0, qh_base + 4u * j, qh);
                float dsc = (j < 4u) ? d0 : d1;
                for (uint b = 0u; b < 4u; b++) {
                    int q = int(((BYTE_OF(ql, b) >> lshift) & 0xFu) | (((BYTE_OF(qh, b) >> hshift) & 3u) << 4)) - 32;
                    ACC(dsc * float(q), blk * 256u + s * 32u + j * 4u + b);
                }
            }
        }
#else
        for (uint i = lane * 4u; i < k; i += uint(TPR) * 4u) {
            vec4 w;
#if defined(SRC0_F32)
            w = vec4(uintBitsToFloat(src0[src0_base + i]),      uintBitsToFloat(src0[src0_base + i + 1u]),
                     uintBitsToFloat(src0[src0_base + i + 2u]), uintBitsToFloat(src0[src0_base + i + 3u]));
#elif defined(SRC0_F16)
            uint w0, w1;
            LOAD_U32_UNALIGNED(src0, (src0_base + i) * 2u, w0);
            LOAD_U32_UNALIGNED(src0, (src0_base + i) * 2u + 4u, w1);
            w = vec4(f16_to_f32(w0), f16_to_f32(w0 >> 16), f16_to_f32(w1), f16_to_f32(w1 >> 16));
#endif
            for (uint c = 0u; c < uint(MAX_COLS); c++) {
                if (c < ncols) {
                    acc[c] += w.x * load_src1(src1_base[c] + i);
                    acc[c] += w.y * load_src1(src1_base[c] + i + 1u);
                    acc[c] += w.z * load_src1(src1_base[c] + i + 2u);
                    acc[c] += w.w * load_src1(src1_base[c] + i + 3u);
                }
            }
        }
#endif
    }

    vec4 row_result;
#if TPR > 1
    // tree reduction inside each TPR block
    for (uint c = 0u; c < uint(MAX_COLS); c++) {
        partial[c][tid] = acc[c];
    }
    memoryBarrierShared();
    barrier();
    for (uint off = uint(TPR) / 2u; off > 0u; off /= 2u) {
        if (lane < off) {
            for (uint c = 0u; c < uint(MAX_COLS); c++) {
                partial[c][tid] += partial[c][tid + off];
            }
        }
        memoryBarrierShared();
        barrier();
    }
    row_result = vec4(partial[0][tid], partial[1][tid], partial[2][tid], partial[3][tid]);
#else
    // one thread per row: no shared memory and no barriers
    row_result = vec4(acc[0], acc[1], acc[2], acc[3]);
#endif

    if (wg_ok && lane == 0u && row < m) {
        uint dst_base = offset_dst + dst3_idx * (m * n * batches2) + dst2_idx * (m * n);
        for (uint c = 0u; c < ncols; c++) {
            STORE_F32(dst, dst_base + (col0 + c) * m + row, row_result[c]);
        }
    }
}
