#include "common.glsl"

// Port of the D3D11 get_rows.hlsl: dst[i1, i2, i3] = src[idx[i1, i2, i3], i2, i3]; idx is i32, one
// thread per element. defines: SRC_{F32,F16,BF16,I32}

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Idx { uint idx[]; };
layout(std430, binding = 2) buffer Dst { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src;
    uint offset_idx;
    uint offset_dst;

    uint stride_src1;
    uint stride_src2;
    uint stride_src3;

    uint stride_idx0;
    uint stride_idx1;
    uint stride_idx2;

    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint ne0;    // dst row length
    uint ne1;    // idx ne0
    uint ne2;    // idx ne1
    uint n_units;

    uint nwg_x;
};

void main() {
    uint t = flat_index(gl_GlobalInvocationID, nwg_x);
    if (t >= n_units) {
        return;
    }
    uint r  = t / ne0;
    uint u  = t % ne0;
    uint i3 = r / (ne2 * ne1);
    r = r % (ne2 * ne1);
    uint i2 = r / ne1;
    uint i1 = r % ne1;

    uint row     = uint(LOAD_I32(idx, offset_idx + i1 * stride_idx0 + i2 * stride_idx1 + i3 * stride_idx2));
    uint src_row = offset_src + row * stride_src1 + i2 * stride_src2 + i3 * stride_src3;
    uint dst_row = offset_dst + i1 * stride_dst1 + i2 * stride_dst2 + i3 * stride_dst3;

#if defined(SRC_F32)
    STORE_F32(dst, dst_row + u, LOAD_F32(src, src_row + u));
#elif defined(SRC_I32)
    STORE_I32(dst, dst_row + u, LOAD_I32(src, src_row + u));
#elif defined(SRC_F16)
    uint bits;
    LOAD_U16_UNALIGNED(src, (src_row + u) * 2u, bits);
    STORE_F32(dst, dst_row + u, f16_to_f32(bits));
#elif defined(SRC_BF16)
    uint bits;
    LOAD_U16_UNALIGNED(src, (src_row + u) * 2u, bits);
    STORE_F32(dst, dst_row + u, uintBitsToFloat(bits << 16));
#endif
}
