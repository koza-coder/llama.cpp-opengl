#include "common.glsl"

// Port of the D3D11 mul_mat_tiled.hlsl, no MUL_MAT_ID:
// dst[row, col] = sum_k src0[row, k] * src1[col, k] for the prompt path.
//
// A workgroup owns a TILE_M x TILE_N tile of dst and walks k in steps of TILE_K: each step loads
// TILE_M x TILE_K weights into shared memory once and every one of them is then used TILE_N times from
// there. Accumulators live in registers, so there is no reduction tree.
//
// defines: SRC0_{F32,F16,BF16,Q4_0,Q4_1,Q5_0,Q5_1,Q8_0,Q2_K,Q3_K,Q4_K,Q5_K,Q6_K,
//          IQ4_NL,IQ4_XS,IQ3_S,IQ2_S,IQ2_XXS,IQ2_XS,IQ3_XXS,IQ1_S,IQ1_M,MXFP4,TQ2_0}, SRC1_F16 (f16 columns instead of f32). k must be a multiple
// of TILE_K. MMID: mul_mat_id, one expert tile of the mul_mat_id_prep.comp table per workgroup.
// src0 offsets/strides are in elements for float types and in blocks for quant types.

#define TILE_M 64
#define TILE_N 32
#define TILE_K 32

// 256 threads as a 16 x 16 grid; each thread owns 4 rows and 2 columns of the output tile
#define TH_X 16
#define TH_Y 16
#define REG_M (TILE_M / TH_Y)
#define REG_N (TILE_N / TH_X)
#define NTHREADS (TH_X * TH_Y)

// GLSL 4.30 takes only a literal here, not an expression
#if NTHREADS != 256
#error NTHREADS must match local_size_x
#endif
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Src1 { uint src1[]; };
layout(std430, binding = 1) buffer Src0 { uint src0[]; };
layout(std430, binding = 2) buffer Dst  { uint dst[]; };
#if defined(MMID)
layout(std430, binding = 3) buffer Scratch { uint scratch[]; };
#endif

layout(std140, binding = 0) uniform Params {
    uint offset_src0;
    uint offset_src1;
    uint offset_dst;
    uint m;           // rows of src0 / dst
    uint n;           // columns of src1 / dst
    uint k;           // shared dimension
    uint stride_01;   // src0 row stride, elements
    uint stride_02;
    uint stride_03;
    uint stride_11;   // src1 column stride, elements
    uint stride_12;
    uint stride_13;
    uint ne2;         // dst dim 2
    uint broadcast2;  // src1 dim 2 / src0 dim 2
    uint broadcast3;
    uint n_batches;   // dst ne2 * ne3; the dispatch is rounded up to a 2D grid, so it can overshoot
#if defined(MMID)
    uint n_used;      // ids->ne[0]
    uint ne11;        // src1->ne[1]; the src1 row of slot s is s % ne11
    uint dst_s1;      // dst->nb[1] in elements
    uint dst_s2;      // dst->nb[2] in elements
    uint list_base;   // first list entry in scratch
#endif
    uint nwg_x;
};

#define BYTE_OF(q, b) (((q) >> ((b) * 8u)) & 0xFFu)
#define SBYTE_OF(q, b) bitfieldExtract(int(q), int((b) * 8u), 8)

#include "quant_tables.glsl"

shared float Atile[TILE_K][TILE_M];
shared float Btile[TILE_K][TILE_N];

#if defined(SRC1_F16)
float load_src1(uint i) {
    uint bits;
    LOAD_U16_UNALIGNED(src1, i * 2u, bits);
    return f16_to_f32(bits);
}
#else
float load_src1(uint i) {
    return LOAD_F32(src1, i);
}
#endif

// the TILE_K elements of one src0 row starting at element k0 into Atile column col
void load_a_row(uint row_base, uint k0, uint col) {
#if defined(SRC0_F32)
    for (uint i = 0u; i < uint(TILE_K); i++) {
        Atile[i][col] = uintBitsToFloat(src0[row_base + k0 + i]);
    }
#elif defined(SRC0_F16)
    for (uint i = 0u; i < uint(TILE_K); i += 2u) {
        uint w;
        LOAD_U32_UNALIGNED(src0, (row_base + k0 + i) * 2u, w);
        Atile[i][col]      = f16_to_f32(w);
        Atile[i + 1u][col] = f16_to_f32(w >> 16);
    }
#elif defined(SRC0_BF16)
    for (uint i = 0u; i < uint(TILE_K); i += 2u) {
        uint w;
        LOAD_U32_UNALIGNED(src0, (row_base + k0 + i) * 2u, w);
        Atile[i][col]      = uintBitsToFloat(w << 16);
        Atile[i + 1u][col] = uintBitsToFloat(w & 0xFFFF0000u);
    }
#elif defined(SRC0_Q8_0)
    // block (34 bytes): f16 d, 32 int8
    uint base = (row_base + k0 / 32u) * 34u;
    uint dbits;
    LOAD_U16_UNALIGNED(src0, base, dbits);
    float d = f16_to_f32(dbits);
    for (uint j = 0u; j < 8u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, base + 2u + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            Atile[j * 4u + b][col] = float(SBYTE_OF(q, b)) * d;
        }
    }
#elif defined(SRC0_Q4_0)
    // block (18 bytes): f16 d, 16 bytes of nibbles; low nibbles are elements 0..15, high nibbles 16..31
    uint base = (row_base + k0 / 32u) * 18u;
    uint dbits;
    LOAD_U16_UNALIGNED(src0, base, dbits);
    float d = f16_to_f32(dbits);
    for (uint j = 0u; j < 4u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, base + 2u + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            uint byte_v = BYTE_OF(q, b);
            Atile[j * 4u + b][col]       = (float(byte_v & 0xFu) - 8.0) * d;
            Atile[16u + j * 4u + b][col] = (float(byte_v >> 4) - 8.0) * d;
        }
    }
#elif defined(SRC0_Q4_1)
    // block (20 bytes): f16 d, f16 m, 16 bytes of nibbles; low nibbles elements 0..15, high 16..31
    uint base = (row_base + k0 / 32u) * 20u;
    uint w;
    LOAD_U32_UNALIGNED(src0, base, w);
    float d  = f16_to_f32(w);
    float mm = f16_to_f32(w >> 16);
    for (uint j = 0u; j < 4u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, base + 4u + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            uint byte_v = BYTE_OF(q, b);
            Atile[j * 4u + b][col] = float(byte_v & 0xFu) * d + mm;
            Atile[16u + j * 4u + b][col] = float(byte_v >> 4) * d + mm;
        }
    }
#elif defined(SRC0_Q5_0)
    // block (22 bytes): f16 d, 32 bits qh, 16 bytes of nibbles; element i takes bit i of qh as bit 4, minus 16
    uint base = (row_base + k0 / 32u) * 22u;
    uint dbits, qh;
    LOAD_U16_UNALIGNED(src0, base, dbits);
    LOAD_U32_UNALIGNED(src0, base + 2u, qh);
    float d = f16_to_f32(dbits);
    for (uint j = 0u; j < 4u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, base + 6u + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            uint byte_v = BYTE_OF(q, b);
            uint i      = j * 4u + b;
            Atile[i][col] = (float((byte_v & 0xFu) | (((qh >> i) & 1u) << 4)) - 16.0) * d;
            Atile[16u + i][col] = (float((byte_v >> 4) | (((qh >> (i + 16u)) & 1u) << 4)) - 16.0) * d;
        }
    }
#elif defined(SRC0_Q5_1)
    // block (24 bytes): f16 d, f16 m, 32 high bits qh, 16 bytes of nibbles; element i adds bit i of qh as bit 4
    uint base = (row_base + k0 / 32u) * 24u;
    uint w, qh;
    LOAD_U32_UNALIGNED(src0, base, w);
    LOAD_U32_UNALIGNED(src0, base + 4u, qh);
    float d  = f16_to_f32(w);
    float mm = f16_to_f32(w >> 16);
    for (uint j = 0u; j < 4u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, base + 8u + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            uint byte_v = BYTE_OF(q, b);
            uint i      = j * 4u + b;
            Atile[i][col] = float((byte_v & 0xFu) | (((qh >> i) & 1u) << 4)) * d + mm;
            Atile[16u + i][col] = float((byte_v >> 4) | (((qh >> (i + 16u)) & 1u) << 4)) * d + mm;
        }
    }
#elif defined(SRC0_Q4_K)
    // super-block of 256 (144 bytes): f16 d, f16 dmin, 12 bytes of 6-bit scales/mins, 128 bytes of nibbles.
    // Sub-block s (32 values): pair s/2 uses bytes 16 + 32*(s/2), low nibbles for even s, high for odd s.
    uint blk  = k0 / 256u;
    uint s    = (k0 % 256u) / 32u;
    uint base = (row_base + blk) * 144u;
    uint w;
    LOAD_U32_UNALIGNED(src0, base, w);
    float d    = f16_to_f32(w);
    float dmin = f16_to_f32(w >> 16);
    uint sc0, sc1, sc2;
    LOAD_U32_UNALIGNED(src0, base + 4u, sc0);
    LOAD_U32_UNALIGNED(src0, base + 8u, sc1);
    LOAD_U32_UNALIGNED(src0, base + 12u, sc2);
    uint sc, mn;
    if (s < 4u) {
        sc = BYTE_OF(sc0, s) & 63u;
        mn = BYTE_OF(sc1, s) & 63u;
    } else {
        sc = (BYTE_OF(sc2, s - 4u) & 0xFu) | ((BYTE_OF(sc0, s - 4u) >> 6) << 4);
        mn = (BYTE_OF(sc2, s - 4u) >> 4) | ((BYTE_OF(sc1, s - 4u) >> 6) << 4);
    }
    float dl    = d * float(sc);
    float ml    = dmin * float(mn);
    uint  shift = (s & 1u) * 4u;
    uint  qbase = base + 16u + 32u * (s / 2u);
    for (uint j = 0u; j < 8u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, qbase + 4u * j, q);
        for (uint b = 0u; b < 4u; b++) {
            Atile[j * 4u + b][col] = dl * float((BYTE_OF(q, b) >> shift) & 0xFu) - ml;
        }
    }
#elif defined(SRC0_Q5_K)
    uint blk = k0 / 256u;
    uint s   = (k0 % 256u) / 32u;
    // super-block of 256 (176 bytes): f16 d, f16 dmin, 12 bytes of 6-bit scales/mins, 32 bytes qh, 128 bytes
    // of nibbles. Sub-block s: nibbles as Q4_K (bytes 48 + 32*(s/2)); value l (0..31) takes bit s of qh byte l as bit 4.
    uint base = (row_base + blk) * 176u;
    uint w;
    LOAD_U32_UNALIGNED(src0, base, w);
    float d    = f16_to_f32(w);
    float dmin = f16_to_f32(w >> 16);
    uint sc0, sc1, sc2;
    LOAD_U32_UNALIGNED(src0, base + 4u, sc0);
    LOAD_U32_UNALIGNED(src0, base + 8u, sc1);
    LOAD_U32_UNALIGNED(src0, base + 12u, sc2);
    uint sc, mn;
    if (s < 4u) {
        sc = BYTE_OF(sc0, s) & 63u;
        mn = BYTE_OF(sc1, s) & 63u;
    } else {
        sc = (BYTE_OF(sc2, s - 4u) & 0xFu) | ((BYTE_OF(sc0, s - 4u) >> 6) << 4);
        mn = (BYTE_OF(sc2, s - 4u) >> 4) | ((BYTE_OF(sc1, s - 4u) >> 6) << 4);
    }
    float dl    = d * float(sc);
    float ml    = dmin * float(mn);
    uint  shift = (s & 1u) * 4u;
    uint  qbase = base + 48u + 32u * (s / 2u);
    for (uint j = 0u; j < 8u; j++) {
        uint q, qh;
        LOAD_U32_UNALIGNED(src0, qbase + 4u * j, q);
        LOAD_U32_UNALIGNED(src0, base + 16u + 4u * j, qh);
        for (uint b = 0u; b < 4u; b++) {
            uint v = ((BYTE_OF(q, b) >> shift) & 0xFu) | (((BYTE_OF(qh, b) >> s) & 1u) << 4);
            Atile[j * 4u + b][col] = dl * float(v) - ml;
        }
    }
#elif defined(SRC0_Q2_K)
    uint blk = k0 / 256u;
    uint s   = (k0 % 256u) / 32u;
    // super-block of 256 (84 bytes): 16 scale bytes (low nibble scale, high nibble min), 64 bytes of 2-bit quants,
    // f16 d, f16 dmin. Sub-block s (32 values): bytes 16 + 32*(s/4) at bit 2*(s%4); values 0..15 use scale byte 2s,
    // 16..31 byte 2s+1 (dequantize_row_q2_K in ggml-quants.c).
    uint base = (row_base + blk) * 84u;
    uint w, scw;
    LOAD_U32_UNALIGNED(src0, base + 80u, w);
    LOAD_U16_UNALIGNED(src0, base + 2u * s, scw);
    float d     = f16_to_f32(w);
    float dmin  = f16_to_f32(w >> 16);
    float dl0   = d * float(scw & 0xFu);
    float ml0   = dmin * float((scw >> 4) & 0xFu);
    float dl1   = d * float((scw >> 8) & 0xFu);
    float ml1   = dmin * float((scw >> 12) & 0xFu);
    uint  shift = (s % 4u) * 2u;
    uint  qbase = base + 16u + 32u * (s / 4u);
    for (uint j = 0u; j < 8u; j++) {
        uint q;
        LOAD_U32_UNALIGNED(src0, qbase + 4u * j, q);
        float dl = (j < 4u) ? dl0 : dl1;
        float ml = (j < 4u) ? ml0 : ml1;
        for (uint b = 0u; b < 4u; b++) {
            Atile[j * 4u + b][col] = dl * float((BYTE_OF(q, b) >> shift) & 3u) - ml;
        }
    }
#elif defined(SRC0_Q3_K)
    uint blk = k0 / 256u;
    uint s   = (k0 % 256u) / 32u;
    // super-block of 256 (110 bytes): 32 bytes hmask, 64 bytes of 2-bit quants, 12 bytes of 6-bit scales, f16 d.
    // Sub-block s: quants as Q2_K (bytes 32 + 32*(s/4) at bit 2*(s%4)); value l subtracts 4 unless bit s of hmask
    // byte l is set. Scale i (2s for values 0..15, 2s+1 for 16..31): low 4 bits from scale byte i%8 at bit 4*(i/8),
    // high 2 bits from byte 8 + i%4 at bit 2*(i/4), minus 32 (dequantize_row_q3_K in ggml-quants.c).
    uint base = (row_base + blk) * 110u;
    uint dbits, lo0, lo1, hi0, hi1;
    LOAD_U16_UNALIGNED(src0, base + 108u, dbits);
    uint i0 = 2u * s;
    uint i1 = 2u * s + 1u;
    LOAD_U32_UNALIGNED(src0, base + 96u + i0 % 8u, lo0);
    LOAD_U32_UNALIGNED(src0, base + 96u + i1 % 8u, lo1);
    LOAD_U32_UNALIGNED(src0, base + 104u + i0 % 4u, hi0);
    LOAD_U32_UNALIGNED(src0, base + 104u + i1 % 4u, hi1);
    float d     = f16_to_f32(dbits);
    float dl0   = d * float(int(((lo0 >> (4u * (i0 / 8u))) & 0xFu) | (((hi0 >> (2u * (i0 / 4u))) & 3u) << 4)) - 32);
    float dl1   = d * float(int(((lo1 >> (4u * (i1 / 8u))) & 0xFu) | (((hi1 >> (2u * (i1 / 4u))) & 3u) << 4)) - 32);
    uint  shift = (s % 4u) * 2u;
    uint  qbase = base + 32u + 32u * (s / 4u);
    for (uint j = 0u; j < 8u; j++) {
        uint q, hm;
        LOAD_U32_UNALIGNED(src0, qbase + 4u * j, q);
        LOAD_U32_UNALIGNED(src0, base + 4u * j, hm);
        float dl = (j < 4u) ? dl0 : dl1;
        for (uint b = 0u; b < 4u; b++) {
            int v = int((BYTE_OF(q, b) >> shift) & 3u) - ((((BYTE_OF(hm, b) >> s) & 1u) != 0u) ? 0 : 4);
            Atile[j * 4u + b][col] = dl * float(v);
        }
    }
#elif defined(SRC0_Q6_K)
    // super-block of 256 (210 bytes): 128 bytes ql, 64 bytes qh, 16 int8 scales, f16 d.
    // Sub-block s: half h = s/4 (128 values), t = s%4 selects the quarter inside the half.
    uint blk  = k0 / 256u;
    uint s    = (k0 % 256u) / 32u;
    uint h    = s / 4u;
    uint t    = s % 4u;
    uint base = (row_base + blk) * 210u;
    uint dbits;
    LOAD_U16_UNALIGNED(src0, base + 208u, dbits);
    float d       = f16_to_f32(dbits);
    uint  ql_base = base + 64u * h + 32u * (t & 1u);
    uint  qh_base = base + 128u + 32u * h;
    uint  sc_base = base + 192u + 8u * h + 2u * t;
    uint  lshift  = (t >> 1) * 4u;
    uint  hshift  = t * 2u;
    uint scw;
    LOAD_U32_UNALIGNED(src0, sc_base, scw);
    float d0 = d * float(SBYTE_OF(scw, 0u));
    float d1 = d * float(SBYTE_OF(scw, 1u));
    for (uint j = 0u; j < 8u; j++) {
        uint ql, qh;
        LOAD_U32_UNALIGNED(src0, ql_base + 4u * j, ql);
        LOAD_U32_UNALIGNED(src0, qh_base + 4u * j, qh);
        float dsc = (j < 4u) ? d0 : d1;
        for (uint b = 0u; b < 4u; b++) {
            int q = int(((BYTE_OF(ql, b) >> lshift) & 0xFu) | (((BYTE_OF(qh, b) >> hshift) & 3u) << 4)) - 32;
            Atile[j * 4u + b][col] = dsc * float(q);
        }
    }
#elif defined(SRC0_IQ4_NL)
    // block (18 bytes): f16 d, 16 bytes of nibbles mapped through the non-linear table
    {
        uint blk = k0 / 32u;
        uint base = (row_base + blk) * 18u;
        uint dbits;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        float d = f16_to_f32(dbits);
        for (uint j = 0u; j < 4u; j++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 2u + 4u * j, q);
            for (uint b = 0u; b < 4u; b++) {
                uint byte_v = BYTE_OF(q, b);
                Atile[blk * 32u + j * 4u + b - k0][col] = KVALUES_IQ4NL[byte_v & 0xFu] * d;
                Atile[blk * 32u + 16u + j * 4u + b - k0][col] = KVALUES_IQ4NL[byte_v >> 4] * d;
            }
        }
    }
#elif defined(SRC0_IQ4_XS)
    // super-block of 256 (136 bytes): f16 d, u16 scales_h, 4 bytes scales_l, 128 bytes of table nibbles.
    // sub-block s: scale = (nibble s of scales_l | 2 bits s of scales_h << 4) - 32; nibble bytes 8 + 16 s.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 136u;
        uint w, sl;
        LOAD_U32_UNALIGNED(src0, base, w);
        LOAD_U32_UNALIGNED(src0, base + 4u, sl);
        float d  = f16_to_f32(w & 0xFFFFu);
        uint  ls = ((BYTE_OF(sl, s / 2u) >> (4u * (s % 2u))) & 0xFu) | ((((w >> 16) >> (2u * s)) & 3u) << 4);
        float dl = d * (float(ls) - 32.0);
        for (uint j = 0u; j < 4u; j++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 8u + 16u * s + 4u * j, q);
            for (uint b = 0u; b < 4u; b++) {
                uint byte_v = BYTE_OF(q, b);
                Atile[blk * 256u + s * 32u + j * 4u + b - k0][col] = KVALUES_IQ4NL[byte_v & 0xFu] * dl;
                Atile[blk * 256u + s * 32u + 16u + j * 4u + b - k0][col] = KVALUES_IQ4NL[byte_v >> 4] * dl;
            }
        }
    }
#elif defined(SRC0_IQ3_S)
    // super-block of 256 (110 bytes): f16 d, 64 bytes qs, 8 bytes qh, 32 bytes signs, 4 bytes scales.
    // sub-block s: scale d * (1 + 2 * nibble s of scales), 4 groups l of 8 values; group l uses grid entries
    // qs[8s + 2l] (values 0..3) and qs[8s + 2l + 1] (values 4..7), 9th index bits 2l and 2l+1 of qh[s];
    // value j of group l is negated when bit j of signs[4s + l] is set
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 110u;
        uint dbits, sc, qh;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 106u + s / 2u, sc);
        LOAD_U32_UNALIGNED(src0, base + 66u + s, qh);
        float db = f16_to_f32(dbits) * float(1u + 2u * ((sc >> (4u * (s & 1u))) & 0xFu));
        for (uint l = 0u; l < 4u; l++) {
            uint q, sg;
            LOAD_U32_UNALIGNED(src0, base + 2u + 8u * s + 2u * l, q);
            LOAD_U32_UNALIGNED(src0, base + 74u + 4u * s + l, sg);
            uint g1 = IQ3S_GRID[(q & 0xFFu) | (((qh >> (2u * l)) & 1u) << 8)];
            uint g2 = IQ3S_GRID[((q >> 8) & 0xFFu) | (((qh >> (2u * l + 1u)) & 1u) << 8)];
            for (uint j = 0u; j < 8u; j++) {
                uint  gv  = j < 4u ? BYTE_OF(g1, j) : BYTE_OF(g2, j - 4u);
                float sgn = ((sg >> j) & 1u) != 0u ? -1.0 : 1.0;
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = db * float(gv) * sgn;
            }
        }
    }
#elif defined(SRC0_IQ2_S)
    // super-block of 256 (82 bytes): f16 d, 64 bytes qs (32 grid indices, then 32 sign bytes), 8 bytes qh,
    // 8 bytes scales. sub-block s: 4 groups l of 8 values from grid entry qs[4s + l] | bits 2l..2l+1 of qh[s] << 8,
    // scale d * (0.5 + nibble) * 0.25 with the low nibble for l < 2; signs in qs[32 + 4s + l]
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 82u;
        uint dbits, sc, qh;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 74u + s, sc);
        LOAD_U32_UNALIGNED(src0, base + 66u + s, qh);
        float d = f16_to_f32(dbits);
        for (uint l = 0u; l < 4u; l++) {
            uint q, sg;
            LOAD_U32_UNALIGNED(src0, base + 2u + 4u * s + l, q);
            LOAD_U32_UNALIGNED(src0, base + 34u + 4u * s + l, sg);
            uint  gi = (q & 0xFFu) | (((qh >> (2u * l)) & 3u) << 8);
            float dl = d * (0.5 + float((sc >> (l < 2u ? 0u : 4u)) & 0xFu)) * 0.25;
            for (uint j = 0u; j < 8u; j++) {
                uint  gv  = j < 4u ? BYTE_OF(IQ2S_GRID_LO[gi], j) : BYTE_OF(IQ2S_GRID_HI[gi], j - 4u);
                float sgn = ((sg >> j) & 1u) != 0u ? -1.0 : 1.0;
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = dl * float(gv) * sgn;
            }
        }
    }
#elif defined(SRC0_MXFP4)
    // block of 32 (17 bytes): e8m0 scale byte, 16 bytes of nibbles indexing the e2m1 table
    {
        uint blk = k0 / 32u;
        uint base = (row_base + blk) * 17u;
        uint ebits;
        LOAD_U16_UNALIGNED(src0, base & ~1u, ebits);
        float d = e8m0_to_f32_half((base & 1u) != 0u ? (ebits >> 8) : (ebits & 0xFFu));
        for (uint j = 0u; j < 4u; j++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 1u + 4u * j, q);
            for (uint b = 0u; b < 4u; b++) {
                uint byte_v = BYTE_OF(q, b);
                Atile[blk * 32u + j * 4u + b - k0][col] = KVALUES_MXFP4[byte_v & 0xFu] * d;
                Atile[blk * 32u + 16u + j * 4u + b - k0][col] = KVALUES_MXFP4[byte_v >> 4] * d;
            }
        }
    }
#elif defined(SRC0_TQ2_0)
    // super-block of 256 (66 bytes): 64 bytes qs, f16 d. Value h * 128 + l * 32 + m is bits 2l..2l+1 of
    // qs[h * 32 + m], minus 1, times d. Sub-block s (of 8) = half h = s / 4, shift l = s % 4.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint h    = s / 4u;
        uint l    = s % 4u;
        uint base = (row_base + blk) * 66u;
        uint dbits;
        LOAD_U16_UNALIGNED(src0, base + 64u, dbits);
        float d = f16_to_f32(dbits);
        for (uint w = 0u; w < 8u; w++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + h * 32u + 4u * w, q);
            for (uint b = 0u; b < 4u; b++) {
                Atile[blk * 256u + h * 128u + l * 32u + w * 4u + b - k0][col] = (float((BYTE_OF(q, b) >> (2u * l)) & 3u) - 1.0) * d;
            }
        }
    }
#elif defined(SRC0_IQ2_XXS)
    // super-block of 256 (66 bytes): f16 d, then 32 uint16 qs. Each sub-block of 32 reads two uint32: the
    // first is four grid indices, the second carries the four 7-bit sign codes and, in its top nibble, the
    // sub-block scale. Scale d * (0.5 + nibble) * 0.25.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 66u;
        uint dbits, a0, a1;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 2u + 8u * s, a0);
        LOAD_U32_UNALIGNED(src0, base + 6u + 8u * s, a1);
        float db = f16_to_f32(dbits) * (0.5 + float(a1 >> 28)) * 0.25;
        for (uint l = 0u; l < 4u; l++) {
            uint gi = BYTE_OF(a0, l);
            uint sg = KSIGNS[(a1 >> (7u * l)) & 127u];
            for (uint j = 0u; j < 8u; j++) {
                uint  gv  = j < 4u ? BYTE_OF(IQ2XXS_GRID_LO[gi], j) : BYTE_OF(IQ2XXS_GRID_HI[gi], j - 4u);
                float sgn = ((sg >> j) & 1u) != 0u ? -1.0 : 1.0;
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = db * float(gv) * sgn;
            }
        }
    }
#elif defined(SRC0_IQ2_XS)
    // super-block of 256 (74 bytes): f16 d, 32 uint16 qs, 8 scale bytes. Each qs entry is a 9-bit grid index
    // plus a 7-bit sign code. The two nibbles of scales[s] scale the first and second half of the sub-block,
    // as d * (0.5 + nibble) * 0.25.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 74u;
        uint dbits, sc;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 66u + s, sc);
        float d   = f16_to_f32(dbits);
        float db0 = d * (0.5 + float(sc & 0xFu)) * 0.25;
        float db1 = d * (0.5 + float((sc >> 4) & 0xFu)) * 0.25;
        for (uint l = 0u; l < 4u; l++) {
            uint q;
            LOAD_U16_UNALIGNED(src0, base + 2u + 2u * (4u * s + l), q);
            uint  gi = q & 511u;
            uint  sg = KSIGNS[(q >> 9) & 127u];
            float dl = l < 2u ? db0 : db1;
            for (uint j = 0u; j < 8u; j++) {
                uint  gv  = j < 4u ? BYTE_OF(IQ2XS_GRID_LO[gi], j) : BYTE_OF(IQ2XS_GRID_HI[gi], j - 4u);
                float sgn = ((sg >> j) & 1u) != 0u ? -1.0 : 1.0;
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = dl * float(gv) * sgn;
            }
        }
    }
#elif defined(SRC0_IQ3_XXS)
    // super-block of 256 (98 bytes): f16 d, 64 grid-index bytes, then 32 bytes of packed scales and signs,
    // one uint32 per sub-block. Group l of 8 values takes two grid entries of 4 bytes; the sign code is bits
    // 7l..7l+6 of that uint32, the scale its top nibble, applied as d * (0.5 + nibble) * 0.5.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 98u;
        uint dbits, aux;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 66u + 4u * s, aux);
        float db = f16_to_f32(dbits) * (0.5 + float(aux >> 28)) * 0.5;
        for (uint l = 0u; l < 4u; l++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 2u + 8u * s + 2u * l, q);
            uint sg = KSIGNS[(aux >> (7u * l)) & 127u];
            uint g1 = IQ3XXS_GRID[q & 0xFFu];
            uint g2 = IQ3XXS_GRID[(q >> 8) & 0xFFu];
            for (uint j = 0u; j < 8u; j++) {
                uint  gv  = j < 4u ? BYTE_OF(g1, j) : BYTE_OF(g2, j - 4u);
                float sgn = ((sg >> j) & 1u) != 0u ? -1.0 : 1.0;
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = db * float(gv) * sgn;
            }
        }
    }
#elif defined(SRC0_IQ1_S)
    // super-block of 256 (50 bytes): f16 d, 32 grid-index low bytes, 8 uint16 qh. Per sub-block qh holds the
    // 3 high bits of each of the four grid indices, a 3-bit scale in bits 12..14 and the sign of the delta in
    // bit 15. The codebook is signed bytes, every value shifted by +-0.125 before scaling.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 50u;
        uint dbits, qh;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U16_UNALIGNED(src0, base + 34u + 2u * s, qh);
        float dl    = f16_to_f32(dbits) * float(2u * ((qh >> 12) & 7u) + 1u);
        float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
        for (uint l = 0u; l < 4u; l++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 2u + 4u * s + l, q);
            uint gi = (q & 0xFFu) | (((qh >> (3u * l)) & 7u) << 8);
            for (uint j = 0u; j < 8u; j++) {
                int gv = j < 4u ? SBYTE_OF(IQ1S_GRID_LO[gi], j) : SBYTE_OF(IQ1S_GRID_HI[gi], j - 4u);
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = dl * (float(gv) + delta);
            }
        }
    }
#elif defined(SRC0_IQ1_M)
    // super-block of 256 (56 bytes): 32 grid-index low bytes, 16 qh bytes, 8 scale bytes, no separate d - the
    // f16 scale is assembled from one nibble of each of the four scale uint16s. Each qh byte carries the 3 high
    // index bits and the delta sign for two groups of 8; each scale uint16 holds two 3-bit scales per half.
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 8u;
        uint s    = sb % 8u;
        uint base = (row_base + blk) * 56u;
        uint sc0, sc1, sc2, sc3;
        LOAD_U16_UNALIGNED(src0, base + 48u, sc0);
        LOAD_U16_UNALIGNED(src0, base + 50u, sc1);
        LOAD_U16_UNALIGNED(src0, base + 52u, sc2);
        LOAD_U16_UNALIGNED(src0, base + 54u, sc3);
        uint  sbits = (sc0 >> 12) | ((sc1 >> 8) & 0x00F0u) | ((sc2 >> 4) & 0x0F00u) | (sc3 & 0xF000u);
        float d     = f16_to_f32(sbits);
        uint  sc    = s < 2u ? sc0 : (s < 4u ? sc1 : (s < 6u ? sc2 : sc3));
        uint  sh    = 6u * (s & 1u);
        float dl1   = d * float(2u * ((sc >> sh) & 7u) + 1u);
        float dl2   = d * float(2u * ((sc >> (sh + 3u)) & 7u) + 1u);
        uint qh0, qh1;
        LOAD_U32_UNALIGNED(src0, base + 32u + 2u * s, qh0);
        qh1 = (qh0 >> 8) & 0xFFu;
        qh0 = qh0 & 0xFFu;
        for (uint l = 0u; l < 4u; l++) {
            uint q;
            LOAD_U32_UNALIGNED(src0, base + 4u * s + l, q);
            uint  hb    = l < 2u ? qh0 : qh1;
            uint  gi    = (q & 0xFFu) | (((l & 1u) == 0u ? (hb << 8) : (hb << 4)) & 0x700u);
            float delta = (hb & ((l & 1u) == 0u ? 0x08u : 0x80u)) != 0u ? -0.125 : 0.125;
            float dl    = l < 2u ? dl1 : dl2;
            for (uint j = 0u; j < 8u; j++) {
                int gv = j < 4u ? SBYTE_OF(IQ1S_GRID_LO[gi], j) : SBYTE_OF(IQ1S_GRID_HI[gi], j - 4u);
                Atile[blk * 256u + s * 32u + l * 8u + j - k0][col] = dl * (float(gv) + delta);
            }
        }
    }
#elif defined(SRC0_Q1_0)
    // block of 128 (18 bytes): f16 d, 16 bytes of sign bits; bit j of the block is +d when set, -d when clear
    {
        uint sb = k0 / 32u;
        uint blk  = sb / 4u;
        uint s    = sb % 4u;
        uint base = (row_base + blk) * 18u;
        uint dbits, q;
        LOAD_U16_UNALIGNED(src0, base, dbits);
        LOAD_U32_UNALIGNED(src0, base + 2u + 4u * s, q);
        float d = f16_to_f32(dbits);
        for (uint j = 0u; j < 32u; j++) {
            Atile[blk * 128u + s * 32u + j - k0][col] = ((q >> j) & 1u) != 0u ? d : -d;
        }
    }
#endif
}

void main() {
    uint tid       = gl_LocalInvocationID.x;
    uint tx        = tid % uint(TH_X);          // column group
    uint ty        = tid / uint(TH_X);          // row group
    uint wg_linear = gl_WorkGroupID.y * nwg_x + gl_WorkGroupID.x;

    uint tiles_m = (m + uint(TILE_M) - 1u) / uint(TILE_M);
    // staging: threads 0..TILE_M-1 take one src0 row each; all threads share the src1 tile,
    // 8 threads per column, 4 values each
    uint b_col  = tid / 8u;
    uint b_part = tid % 8u;

#if defined(MMID)
    // one tile of the table from mul_mat_id_prep.comp: one expert, up to TILE_N of its (token, slot) pairs as the
    // columns. Workgroups past the tile count compute tile 0 with no columns and store nothing.
    uint row0   = (wg_linear % tiles_m) * uint(TILE_M);
    uint ct     = wg_linear / tiles_m;
    bool wg_ok  = ct < scratch[0];
    uvec3 tile  = uvec3(0u);
    if (wg_ok) {
        tile = uvec3(scratch[1u + 3u * ct], scratch[2u + 3u * ct], scratch[3u + 3u * ct]);
    }
    uint a_batch = offset_src0 + tile.x * stride_02;
    uint n_cols  = tile.z;
    bool b_ok    = b_col < n_cols;
    uint b_base  = 0u;
    if (b_ok) {
        uint pair = scratch[list_base + tile.y + b_col];
        b_base = offset_src1 + ((pair % n_used) % ne11) * stride_11 + (pair / n_used) * stride_12;
    }
#else
    uint tiles_n = (n + uint(TILE_N) - 1u) / uint(TILE_N);
    uint tile_id = wg_linear % (tiles_m * tiles_n);
    uint batch   = wg_linear / (tiles_m * tiles_n);

    // workgroups past the batch count compute batch 0 and store nothing (no early return before barriers)
    bool wg_ok = batch < n_batches;
    if (!wg_ok) {
        batch = 0u;
    }
    uint batches2  = ne2;
    uint dst2_idx  = batch % batches2;
    uint dst3_idx  = batch / batches2;
    uint src02_idx = dst2_idx / broadcast2;
    uint src03_idx = dst3_idx / broadcast3;

    uint row0 = (tile_id % tiles_m) * uint(TILE_M);
    uint col0 = (tile_id / tiles_m) * uint(TILE_N);

    uint a_batch = offset_src0 + src03_idx * stride_03 + src02_idx * stride_02;
    uint b_batch = offset_src1 + dst3_idx * stride_13 + dst2_idx * stride_12;
    bool b_ok    = col0 + b_col < n;
    uint b_base  = b_batch + (col0 + b_col) * stride_11;
#endif

    float acc[REG_M][REG_N];
    for (uint im = 0u; im < uint(REG_M); im++) {
        for (uint jn = 0u; jn < uint(REG_N); jn++) {
            acc[im][jn] = 0.0;
        }
    }

    // the loop bound is the uniform k for every workgroup: the MTT S80 compiler aborts on a barrier inside a loop
    // whose bound depends on the workgroup ("barrierOp in dynamic branch"). Overshoot workgroups read batch 0.
    for (uint kt = 0u; kt < k; kt += uint(TILE_K)) {
        if (tid < uint(TILE_M)) {
            uint r = row0 + tid;
            if (r < m) {
                load_a_row(a_batch + r * stride_01, kt, tid);
            } else {
                for (uint z = 0u; z < uint(TILE_K); z++) {
                    Atile[z][tid] = 0.0;
                }
            }
        }
        for (uint i = 0u; i < 4u; i++) {
            uint ki = b_part * 4u + i;
            Btile[ki][b_col] = b_ok ? load_src1(b_base + kt + ki) : 0.0;
        }
        memoryBarrierShared();
        barrier();

        for (uint kk = 0u; kk < uint(TILE_K); kk++) {
            float a[REG_M];
            float b[REG_N];
            for (uint im2 = 0u; im2 < uint(REG_M); im2++) {
                a[im2] = Atile[kk][ty * uint(REG_M) + im2];
            }
            for (uint in2 = 0u; in2 < uint(REG_N); in2++) {
                b[in2] = Btile[kk][tx * uint(REG_N) + in2];
            }
            for (uint im3 = 0u; im3 < uint(REG_M); im3++) {
                for (uint in3 = 0u; in3 < uint(REG_N); in3++) {
                    acc[im3][in3] += a[im3] * b[in3];
                }
            }
        }
        memoryBarrierShared();
        barrier();
    }

    if (!wg_ok) {
        return;
    }
#if !defined(MMID)
    uint dst_base = offset_dst + dst3_idx * (m * n * batches2) + dst2_idx * (m * n);
#endif
    for (uint im4 = 0u; im4 < uint(REG_M); im4++) {
        uint r = row0 + ty * uint(REG_M) + im4;
        if (r >= m) {
            continue;
        }
        for (uint in4 = 0u; in4 < uint(REG_N); in4++) {
#if defined(MMID)
            uint j = tx * uint(REG_N) + in4;
            if (j < n_cols) {
                uint pair = scratch[list_base + tile.y + j];
                STORE_F32(dst, offset_dst + (pair % n_used) * dst_s1 + (pair / n_used) * dst_s2 + r, acc[im4][in4]);
            }
#else
            uint c = col0 + tx * uint(REG_N) + in4;
            if (c < n) {
                STORE_F32(dst, dst_base + c * m + r, acc[im4][in4]);
            }
#endif
        }
    }
}
