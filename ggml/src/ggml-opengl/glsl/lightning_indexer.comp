#include "common.glsl"

// LIGHTNING_INDEXER (DSA): dst[ik, t, s] = sum_h max(q[:, h, t, s] . k[:, 0, ik, s], 0) * w[h, t, s]
//                                          + mask[ik, t, s % mask_ne3]
// One thread per output. q, w, dst f32; mask f16; K f32, or f16, bf16 or quantised (blocks of 32: stride_k2 etc. then count blocks) with K_F16, K_BF16, K_Q8_0, K_Q4_0, K_Q4_1, K_Q5_0, K_Q5_1, K_IQ4_NL.
// Offsets and strides in elements.

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Q    { uint q_buf[]; };
layout(std430, binding = 1) buffer K    { uint k_buf[]; };
layout(std430, binding = 2) buffer W    { uint w_buf[]; };
layout(std430, binding = 3) buffer Mask { uint mask[]; };
layout(std430, binding = 4) buffer Dst  { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_q;
    uint offset_k;
    uint offset_w;
    uint offset_m;
    uint offset_dst;

    uint stride_q1;
    uint stride_q2;
    uint stride_q3;
    uint stride_k2;
    uint stride_k3;
    uint stride_w1;
    uint stride_w3;
    uint stride_m1;
    uint stride_m3;
    uint stride_d1;
    uint stride_d3;

    uint n_embd;
    uint n_head;
    uint n_kv;
    uint n_tokens;
    uint mask_ne3;
    uint n_out;

    uint nwg_x;
};

#if defined(K_F16)
#define KVAL(row, e) LOAD_F16(k_buf, (row) + (e))
#elif defined(K_BF16)
float k_bf16(uint i) {
    uint bits;
    LOAD_U16_UNALIGNED(k_buf, i * 2, bits);
    return uintBitsToFloat(bits << 16);
}
#define KVAL(row, e) k_bf16((row) + (e))
#elif defined(K_Q8_0) || defined(K_Q4_0) || defined(K_Q4_1) || defined(K_Q5_0) || defined(K_Q5_1) || defined(K_IQ4_NL)
const float KVALUES_IQ4NL[16] = float[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);

uint k_byte(uint a) {
    return (k_buf[a >> 2] >> ((a & 3u) * 8u)) & 0xFFu;
}

// element e of the row whose first block is number `row` (blocks of 32 values)
float k_quant(uint row, uint e) {
    const uint j = e & 31u;
#if defined(K_Q8_0)
    const uint base = (row + (e >> 5)) * 34u;
    uint dbits;
    LOAD_U16_UNALIGNED(k_buf, base, dbits);
    int q = int(k_byte(base + 2u + j));
    q = q > 127 ? q - 256 : q;
    return float(q) * f16_to_f32(dbits);
#elif defined(K_Q4_0) || defined(K_IQ4_NL)
    const uint base = (row + (e >> 5)) * 18u;
    uint dbits;
    LOAD_U16_UNALIGNED(k_buf, base, dbits);
    const uint b   = k_byte(base + 2u + (j & 15u));
    const uint nib = j < 16u ? (b & 0xFu) : (b >> 4);
#if defined(K_IQ4_NL)
    return KVALUES_IQ4NL[nib] * f16_to_f32(dbits);
#else
    return (float(nib) - 8.0) * f16_to_f32(dbits);
#endif
#elif defined(K_Q4_1)
    const uint base = (row + (e >> 5)) * 20u;
    uint dbits, mbits;
    LOAD_U16_UNALIGNED(k_buf, base, dbits);
    LOAD_U16_UNALIGNED(k_buf, base + 2u, mbits);
    const uint b   = k_byte(base + 4u + (j & 15u));
    const uint nib = j < 16u ? (b & 0xFu) : (b >> 4);
    return float(nib) * f16_to_f32(dbits) + f16_to_f32(mbits);
#elif defined(K_Q5_0)
    const uint base = (row + (e >> 5)) * 22u;
    uint dbits, qh;
    LOAD_U16_UNALIGNED(k_buf, base, dbits);
    LOAD_U32_UNALIGNED(k_buf, base + 2u, qh);
    const uint b = k_byte(base + 6u + (j & 15u));
    const uint x = (j < 16u ? (b & 0xFu) : (b >> 4)) | (((qh >> j) & 1u) << 4);
    return (float(x) - 16.0) * f16_to_f32(dbits);
#else   // K_Q5_1
    const uint base = (row + (e >> 5)) * 24u;
    uint dbits, mbits, qh;
    LOAD_U16_UNALIGNED(k_buf, base, dbits);
    LOAD_U16_UNALIGNED(k_buf, base + 2u, mbits);
    LOAD_U32_UNALIGNED(k_buf, base + 4u, qh);
    const uint b = k_byte(base + 8u + (j & 15u));
    const uint x = (j < 16u ? (b & 0xFu) : (b >> 4)) | (((qh >> j) & 1u) << 4);
    return float(x) * f16_to_f32(dbits) + f16_to_f32(mbits);
#endif
}
#define KVAL(row, e) k_quant((row), (e))
#else
#define KVAL(row, e) LOAD_F32(k_buf, (row) + (e))
#endif

void main() {
    uint i = flat_index(gl_GlobalInvocationID, nwg_x);
    if (i >= n_out) {
        return;
    }
    uint ik = i % n_kv;
    uint t  = (i / n_kv) % n_tokens;
    uint s  = i / (n_kv * n_tokens);

    uint k_base = offset_k + ik * stride_k2 + s * stride_k3;
    uint w_base = offset_w + t * stride_w1 + s * stride_w3;
    float score = 0.0;
    for (uint h = 0u; h < n_head; h++) {
        uint  q_base = offset_q + h * stride_q1 + t * stride_q2 + s * stride_q3;
        float qk     = 0.0;
        for (uint e = 0u; e < n_embd; e++) {
            qk += LOAD_F32(q_buf, q_base + e) * KVAL(k_base, e);
        }
        score += max(qk, 0.0) * LOAD_F32(w_buf, w_base + h);
    }
    uint m_i = offset_m + t * stride_m1 + (s % mask_ne3) * stride_m3 + ik;
    STORE_F32(dst, offset_dst + t * stride_d1 + s * stride_d3 + ik, score + LOAD_F16(mask, m_i));
}
