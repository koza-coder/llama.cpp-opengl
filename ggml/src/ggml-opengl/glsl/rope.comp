#include "common.glsl"

// Port of the D3D11 rope.hlsl (same kernel, GLSL syntax).

// defines: TYPE_F32 or TYPE_F16, FF_FUNC when frequency factors are present,
// BACKWARD for ROPE_BACK, which is this same rotation with the sine negated

#ifdef BACKWARD
#define SIN_SIGN (-1.0)
#else
#define SIN_SIGN (1.0)
#endif

#if defined(TYPE_F16)
#define LOAD(buf, i)     LOAD_F16(buf, i)
#define STORE(buf, i, v) STORE_F16(buf, i, v)
#else
#define LOAD(buf, i)     LOAD_F32(buf, i)
#define STORE(buf, i, v) STORE_F32(buf, i, v)
#endif

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src0 { uint src0[]; };
layout(std430, binding = 1) buffer Src1 { uint src1[]; };   // positions, i32
layout(std430, binding = 2) buffer Src2 { uint src2[]; };   // frequency factors, f32
layout(std430, binding = 3) buffer Dst  { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src0;
    uint offset_src1;
    uint offset_src2;
    uint offset_dst;

    uint stride_src01;
    uint stride_src02;
    uint stride_src03;

    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint n_threads;
    uint ne0;
    uint ne1;
    uint ne2;

    uint n_dims;
    uint mode;
    float theta_scale;
    float attn_factor;
    float freq_scale;
    float ext_factor;
    float corr_dim0;
    float corr_dim1;
    uint sections0;
    uint sections1;
    uint sections2;
    uint sections3;
    uint n_offs;

    uint nwg_x;
};

float freq_factor(uint i) {
#ifdef FF_FUNC
    return LOAD_F32(src2, offset_src2 + i / 2);
#else
    return 1.0;
#endif
}

float rope_yarn_ramp(float low, float high, uint i) {
    float y = (float(i / 2) - low) / max(0.001, high - low);
    return 1.0 - min(1.0, max(0.0, y));
}

vec2 rope_yarn(float theta_extrap, uint i) {
    float mscale = attn_factor;
    float theta  = freq_scale * theta_extrap;
    if (ext_factor != 0.0) {
        float ramp_mix = rope_yarn_ramp(corr_dim0, corr_dim1, i) * ext_factor;
        theta = theta * (1.0 - ramp_mix) + theta_extrap * ramp_mix;
        mscale *= 1.0 + 0.1 * log(1.0 / freq_scale);
    }
    return vec2(cos(theta) * mscale, SIN_SIGN * sin(theta) * mscale);
}

void main() {
    uint t = flat_index(gl_GlobalInvocationID, nwg_x);
    if (t >= n_threads) {
        return;
    }
    bool is_neox   = (mode & 2u) != 0;
    bool is_mrope  = (mode & 8u) != 0;
    bool is_imrope = mode == 40u;
    bool is_vision = mode == 24u;

    uint i = t * 2;
    uint i3 = i / (ne2 * ne1 * ne0);
    i = i % (ne2 * ne1 * ne0);
    uint i2 = i / (ne1 * ne0);
    i = i % (ne1 * ne0);
    uint i1 = i / ne0;
    uint i0 = i % ne0;

    uint src_row = offset_src0 + i3 * stride_src03 + i2 * stride_src02 + i1 * stride_src01;
    uint dst_row = offset_dst + i3 * stride_dst3 + i2 * stride_dst2 + i1 * stride_dst1;

    if ((i0 < n_offs || i0 >= n_offs + n_dims) && !is_vision) {
        STORE(dst, dst_row + i0, LOAD(src0, src_row + i0));
        STORE(dst, dst_row + i0 + 1, LOAD(src0, src_row + i0 + 1));
        return;
    }

    uint iw = i0 - n_offs;
    uint theta_base_mult = 0;
    uint theta_scale_pwr = iw / 2;
    if (is_mrope) {
        uint sect_dims = sections0 + sections1 + sections2 + sections3;
        uint sec_w     = sections1 + sections0;
        uint sec_e     = sections2 + sec_w;
        uint sector    = (iw / 2) % sect_dims;
        if (is_imrope) {
            if (sector % 3 == 1 && sector < 3 * sections1) {
                theta_base_mult = 1;
            } else if (sector % 3 == 2 && sector < 3 * sections2) {
                theta_base_mult = 2;
            } else if (sector % 3 == 0 && sector < 3 * sections0) {
                theta_base_mult = 0;
            } else {
                theta_base_mult = 3;
            }
        } else {
            if (sector >= sections0 && sector < sec_w) {
                theta_base_mult = 1;
                if (is_vision) { theta_scale_pwr = sector - sections0; }
            } else if (sector >= sec_w && sector < sec_e) {
                theta_base_mult = 2;
                if (is_vision) { theta_scale_pwr = sector - sec_w; }
            } else if (sector >= sec_e) {
                if (is_vision) { theta_scale_pwr = (iw / 2) % sec_e; }
                theta_base_mult = 3;
            } else if (is_vision) {
                theta_scale_pwr = sector;
            }
        }
    }
    float pos        = float(LOAD_I32(src1, offset_src1 + i2 + ne2 * theta_base_mult));
    float theta_base = pos * pow(theta_scale, float(theta_scale_pwr));
    vec2 thetas    = rope_yarn(theta_base / freq_factor(iw), iw);

    bool div2 = is_neox || is_mrope || is_vision;
    uint pair_base = div2 ? (i0 / 2 + n_offs / 2) : i0;
    uint pair_off  = is_vision ? n_dims : ((is_neox || is_mrope) ? n_dims / 2 : 1);

    float x0 = LOAD(src0, src_row + pair_base);
    float x1 = LOAD(src0, src_row + pair_base + pair_off);
    STORE(dst, dst_row + pair_base, x0 * thetas.x - x1 * thetas.y);
    STORE(dst, dst_row + pair_base + pair_off, x0 * thetas.y + x1 * thetas.x);
}
