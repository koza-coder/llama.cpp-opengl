#include "common.glsl"

// Port of the D3D11 set_rows.hlsl: dst[idx[row]] = src[row]; src is f32, or f16 with SRC_F16.
// defines: DST_{F32,F16,BF16}, SRC_F16 (f32 -> bf16: round to nearest even, a NaN stays a NaN), I64_IDX (the low 32 bits of each index are used)

#if defined(DST_F16)
#define STORE_DST(i, v) STORE_F16(dst, i, v)
#elif defined(DST_BF16)
uint f32_to_bf16_bits(float f) {
    const uint x = floatBitsToUint(f);
    if ((x & 0x7FFFFFFFu) > 0x7F800000u) {
        return (x >> 16) | 0x40u;
    }
    return (x + 0x7FFFu + ((x >> 16) & 1u)) >> 16;
}
// no 16-bit stores: write the half with two atomics so the neighbouring element is kept
#define STORE_DST(i, v) { \
    const uint _b  = f32_to_bf16_bits(v); \
    const uint _sh = (((i) * 2u) & 2u) * 8u; \
    atomicAnd(dst[((i) * 2u) >> 2], ~(0xFFFFu << _sh)); \
    atomicOr(dst[((i) * 2u) >> 2], _b << _sh); \
}
#else
#define STORE_DST(i, v) STORE_F32(dst, i, v)
#endif

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Idx { uint idx[]; };
layout(std430, binding = 2) buffer Dst { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src;
    uint offset_idx;
    uint offset_dst;

    uint stride_src1;
    uint stride_src2;
    uint stride_src3;

    uint stride_idx0;
    uint stride_idx1;
    uint stride_idx2;

    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint ne0;
    uint n_rows;
    uint ne2;
    uint ne3;

    uint idx1;
    uint idx2;

    uint nwg_x;
};

void main() {
    uint i = flat_index(gl_GlobalInvocationID, nwg_x);
    if (i >= ne3 * ne2 * n_rows * ne0) {
        return;
    }
    uint row = i / ne0;
    uint col = i % ne0;

    uint i_src3 = row / (ne2 * n_rows);
    row = row % (ne2 * n_rows);
    uint i_src2 = row / n_rows;
    uint i_src1 = row % n_rows;

    uint idx_elem = offset_idx + i_src1 * stride_idx0 + (i_src2 % idx1) * stride_idx1 + (i_src3 % idx2) * stride_idx2;
#ifdef I64_IDX
    uint idx_val = idx[idx_elem * 2u];
#else
    uint idx_val = idx[idx_elem];
#endif

    uint i_dst_row = offset_dst + idx_val * stride_dst1 + i_src2 * stride_dst2 + i_src3 * stride_dst3;
    uint i_src_row = offset_src + i_src1 * stride_src1 + i_src2 * stride_src2 + i_src3 * stride_src3;

#if defined(SRC_F16)
    STORE_DST(i_dst_row + col, LOAD_F16(src, i_src_row + col));
#else
    STORE_DST(i_dst_row + col, LOAD_F32(src, i_src_row + col));
#endif
}
