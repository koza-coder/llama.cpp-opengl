#include "common.glsl"

// Port of the D3D12 group_norm.hlsl. GROUP_NORM (f32): channels are split into n_groups consecutive groups; every
// group is normalised over (channels in group) x ne01 x ne00 for each i03. One workgroup owns one (group, i03) pair:
// mean, then centre-and-variance (the centred value is written out), then scale in place - the CPU order.

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Dst { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint  offset_src;
    uint  offset_dst;
    uint  stride_src1;
    uint  stride_src2;
    uint  stride_src3;
    uint  stride_dst1;
    uint  stride_dst2;
    uint  stride_dst3;
    uint  ne0;
    uint  ne1;
    uint  n_channels;
    uint  n_groups;
    uint  channels_per_group;
    uint  n_batches;
    float eps;
    uint  nwg_x;
};

shared float scratch[WG_SIZE];

float group_reduce(uint tid, float v) {
    scratch[tid] = v;
    barrier();
    for (uint off = WG_SIZE / 2; off > 0; off /= 2) {
        if (tid < off) {
            scratch[tid] += scratch[tid + off];
        }
        barrier();
    }
    const float total = scratch[0];
    barrier();
    return total;
}

void main() {
    const uint job = gl_WorkGroupID.y * nwg_x + gl_WorkGroupID.x;
    if (job >= n_groups * n_batches) {
        return;
    }
    const uint g   = job % n_groups;
    const uint i03 = job / n_groups;

    const uint start = g * channels_per_group;
    const uint end   = min(start + channels_per_group, n_channels);
    const uint count = (end - start) * ne1 * ne0;
    const uint tid   = gl_LocalInvocationID.x;

    float sum = 0.0;
    for (uint i = tid; i < count; i += WG_SIZE) {
        const uint i00 = i % ne0;
        const uint i01 = (i / ne0) % ne1;
        const uint i02 = start + i / (ne0 * ne1);
        sum += LOAD_F32(src, offset_src + i03 * stride_src3 + i02 * stride_src2 + i01 * stride_src1 + i00);
    }
    const float mean = group_reduce(tid, sum) / float(count);

    float sum2 = 0.0;
    for (uint i = tid; i < count; i += WG_SIZE) {
        const uint i00 = i % ne0;
        const uint i01 = (i / ne0) % ne1;
        const uint i02 = start + i / (ne0 * ne1);
        const float v = LOAD_F32(src, offset_src + i03 * stride_src3 + i02 * stride_src2 + i01 * stride_src1 + i00) - mean;
        STORE_F32(dst, offset_dst + i03 * stride_dst3 + i02 * stride_dst2 + i01 * stride_dst1 + i00, v);
        sum2 += v * v;
    }
    const float variance = group_reduce(tid, sum2) / float(count);
    const float scale    = 1.0 / sqrt(variance + eps);

    for (uint i = tid; i < count; i += WG_SIZE) {
        const uint i00 = i % ne0;
        const uint i01 = (i / ne0) % ne1;
        const uint i02 = start + i / (ne0 * ne1);
        const uint o   = offset_dst + i03 * stride_dst3 + i02 * stride_dst2 + i01 * stride_dst1 + i00;
        STORE_F32(dst, o, LOAD_F32(dst, o) * scale);
    }
}
