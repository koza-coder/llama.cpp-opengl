#include "common.glsl"

// Port of the D3D12 add1.hlsl (tools/hlsl2glsl/port.py + hand fixes).

// ADD1 (f32): dst = src0 + src1[0]. The addend is a scalar living in device memory, so it is read
// from the buffer rather than passed in the constant buffer.

layout(std430, binding = 0) buffer Buf0 { uint src0[]; };
layout(std430, binding = 1) buffer Buf1 { uint src1[]; };
layout(std430, binding = 2) buffer Buf2 { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src0;
    uint offset_src1;
    uint offset_dst;
    uint stride_01;
    uint stride_02;
    uint stride_03;
    uint stride_d1;
    uint stride_d2;
    uint stride_d3;
    uint ne0;
    uint ne1;
    uint ne2;
    uint n_rows;
    uint nwg_x;
};

layout(local_size_x = WG_SIZE) in;

void main() {
    const uvec3 gtid = gl_LocalInvocationID;
    const uvec3 gid = gl_WorkGroupID;
    uint r = gid.y * nwg_x + gid.x;
    if (r >= n_rows) {
        return;
    }
    const uint i3 = r / (ne2 * ne1);
    r = r % (ne2 * ne1);
    const uint i2 = r / ne1;
    const uint i1 = r % ne1;

    const uint src_row = offset_src0 + i3 * stride_03 + i2 * stride_02 + i1 * stride_01;
    const uint dst_row = offset_dst + i3 * stride_d3 + i2 * stride_d2 + i1 * stride_d1;
    const float addend = LOAD_F32(src1, offset_src1);

    for (uint c = gtid.x; c < ne0; c += WG_SIZE) {
        STORE_F32(dst, dst_row + c, LOAD_F32(src0, src_row + c) + addend);
    }
}
