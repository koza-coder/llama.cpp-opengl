#include "common.glsl"

// SET_ROWS f32 -> q4_0 / q4_1 / q5_0 / q5_1 / q8_0 (port of the D3D12 set_rows_q8.hlsl, more block types):
// dst[idx[row]] = quantize(src[row]), one thread per source row, quantized as the CPU reference does
// (quantize_row_*_ref). Blocks are 18..34 bytes, so rows do not start on word boundaries; a row writes its bytes
// word by word and keeps the neighbour bytes of its first and last word. Rows whose global dst row numbers have
// the other parity run in a second dispatch, so two threads never touch the same word. dst is contiguous;
// offsets and strides are in blocks. defines: DST_Q4_0, DST_Q4_1, DST_Q5_0, DST_Q5_1 or DST_Q8_0; I64_IDX

#if defined(DST_Q4_0)
#define BLOCK_BYTES 18u
#elif defined(DST_Q4_1)
#define BLOCK_BYTES 20u
#elif defined(DST_Q5_0)
#define BLOCK_BYTES 22u
#elif defined(DST_Q5_1)
#define BLOCK_BYTES 24u
#else
#define BLOCK_BYTES 34u
#endif

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Idx { uint idx[]; };
layout(std430, binding = 2) buffer Dst { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src;
    uint offset_idx;
    uint offset_dst;

    uint stride_src1;
    uint stride_src2;
    uint stride_src3;

    uint stride_idx0;
    uint stride_idx1;
    uint stride_idx2;

    uint stride_dst1;   // blocks per dst row
    uint dst_ne1;
    uint dst_ne2;

    uint ne0;
    uint n_rows;
    uint ne2;
    uint ne3;

    uint idx1;
    uint idx2;
    uint parity;

    uint nwg_x;
};

uint g_word;
uint g_pos;
uint g_end;

// append one byte to the row
void put_byte(uint b) {
    if ((g_pos & 3u) == 0u) {
        // a word that the row does not fill to the end keeps the neighbour's high bytes
        g_word = g_pos + 4u > g_end ? dst[g_pos >> 2] : 0u;
    }
    uint sh = (g_pos & 3u) * 8u;
    g_word = (g_word & ~(0xFFu << sh)) | ((b & 0xFFu) << sh);
    if ((g_pos & 3u) == 3u || g_pos + 1u == g_end) {
        dst[g_pos >> 2] = g_word;
    }
    g_pos++;
}

void put_u16(uint v) {
    put_byte(v);
    put_byte(v >> 8);
}

void main() {
    uint row = flat_index(gl_GlobalInvocationID, nwg_x);
    if (row >= ne3 * ne2 * n_rows) {
        return;
    }
    uint i_src3 = row / (ne2 * n_rows);
    row = row % (ne2 * n_rows);
    uint i_src2 = row / n_rows;
    uint i_src1 = row % n_rows;

    uint idx_elem = offset_idx + i_src1 * stride_idx0 + (i_src2 % idx1) * stride_idx1 + (i_src3 % idx2) * stride_idx2;
#ifdef I64_IDX
    uint idx_val = idx[idx_elem * 2u];
#else
    uint idx_val = idx[idx_elem];
#endif
    uint grow = (i_src3 * dst_ne2 + i_src2) * dst_ne1 + idx_val;   // dst row number in the contiguous tensor
    if ((grow & 1u) != parity) {
        return;
    }

    uint i_src_row = offset_src + i_src1 * stride_src1 + i_src2 * stride_src2 + i_src3 * stride_src3;
    uint base      = (offset_dst + grow * stride_dst1) * BLOCK_BYTES;
    uint n_blocks  = ne0 / 32u;
    g_end = base + n_blocks * BLOCK_BYTES;
    g_pos = base;

    // the first word may start before the row: keep the neighbour's low bytes
    g_word = dst[base >> 2];
    for (uint b = 0u; b < n_blocks; b++) {
        uint x0 = i_src_row + b * 32u;
#if defined(DST_Q8_0)
        float amax = 0.0;
        for (uint j = 0u; j < 32u; j++) {
            amax = max(amax, abs(LOAD_F32(src, x0 + j)));
        }
        float d  = amax / 127.0;
        float id = d != 0.0 ? 1.0 / d : 0.0;
        put_u16(f32_to_f16_rne(d));
        for (uint j = 0u; j < 32u; j++) {
            float x = LOAD_F32(src, x0 + j) * id;
            put_byte(uint(int(sign(x) * floor(abs(x) + 0.5))));   // roundf: halves away from zero
        }
#elif defined(DST_Q4_0) || defined(DST_Q5_0)
        // the element of largest magnitude, with its sign
        float amax = 0.0;
        float vmax = 0.0;
        for (uint j = 0u; j < 32u; j++) {
            float v = LOAD_F32(src, x0 + j);
            if (amax < abs(v)) {
                amax = abs(v);
                vmax = v;
            }
        }
#if defined(DST_Q4_0)
        float d  = vmax / -8.0;
#else
        float d  = vmax / -16.0;
#endif
        float id = d != 0.0 ? 1.0 / d : 0.0;
        put_u16(f32_to_f16_rne(d));
#if defined(DST_Q5_0)
        uint qh = 0u;
        for (uint j = 0u; j < 16u; j++) {
            uint q0 = uint(min(31, int(LOAD_F32(src, x0 + j) * id + 16.5)));
            uint q1 = uint(min(31, int(LOAD_F32(src, x0 + j + 16u) * id + 16.5)));
            qh |= ((q0 & 0x10u) >> 4) << j;
            qh |= ((q1 & 0x10u) >> 4) << (j + 16u);
        }
        put_u16(qh);
        put_u16(qh >> 16);
#endif
        for (uint j = 0u; j < 16u; j++) {
#if defined(DST_Q4_0)
            uint q0 = uint(min(15, int(LOAD_F32(src, x0 + j) * id + 8.5)));
            uint q1 = uint(min(15, int(LOAD_F32(src, x0 + j + 16u) * id + 8.5)));
#else
            uint q0 = uint(min(31, int(LOAD_F32(src, x0 + j) * id + 16.5)));
            uint q1 = uint(min(31, int(LOAD_F32(src, x0 + j + 16u) * id + 16.5)));
#endif
            put_byte((q0 & 0xFu) | ((q1 & 0xFu) << 4));
        }
#else
        // q4_1 / q5_1: min and range
        float vmin = 3.4028235e38;
        float vmax = -3.4028235e38;
        for (uint j = 0u; j < 32u; j++) {
            float v = LOAD_F32(src, x0 + j);
            vmin = min(vmin, v);
            vmax = max(vmax, v);
        }
#if defined(DST_Q4_1)
        float d  = (vmax - vmin) / 15.0;
#else
        float d  = (vmax - vmin) / 31.0;
#endif
        float id = d != 0.0 ? 1.0 / d : 0.0;
        put_u16(f32_to_f16_rne(d));
        put_u16(f32_to_f16_rne(vmin));
#if defined(DST_Q5_1)
        uint qh = 0u;
        for (uint j = 0u; j < 16u; j++) {
            uint q0 = uint(int((LOAD_F32(src, x0 + j) - vmin) * id + 0.5));
            uint q1 = uint(int((LOAD_F32(src, x0 + j + 16u) - vmin) * id + 0.5));
            qh |= ((q0 & 0x10u) >> 4) << j;
            qh |= ((q1 & 0x10u) >> 4) << (j + 16u);
        }
        put_u16(qh);
        put_u16(qh >> 16);
#endif
        for (uint j = 0u; j < 16u; j++) {
#if defined(DST_Q4_1)
            uint q0 = uint(min(15, int((LOAD_F32(src, x0 + j) - vmin) * id + 0.5)));
            uint q1 = uint(min(15, int((LOAD_F32(src, x0 + j + 16u) - vmin) * id + 0.5)));
#else
            uint q0 = uint(int((LOAD_F32(src, x0 + j) - vmin) * id + 0.5));
            uint q1 = uint(int((LOAD_F32(src, x0 + j + 16u) - vmin) * id + 0.5));
#endif
            put_byte((q0 & 0xFu) | ((q1 & 0xFu) << 4));
        }
#endif
    }
}
