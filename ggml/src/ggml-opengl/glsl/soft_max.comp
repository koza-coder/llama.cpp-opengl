#include "common.glsl"

// Port of the D3D11 soft_max.hlsl without its register cache. One workgroup per row.
// defines: HAS_MASK with MASK_F32 or MASK_F16, HAS_SINK

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src   { uint src[]; };
layout(std430, binding = 1) buffer Mask  { uint mask[]; };
layout(std430, binding = 2) buffer Sinks { uint sinks[]; };
layout(std430, binding = 3) buffer Dst   { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint offset_src0;
    uint offset_src1;
    uint offset_sinks;
    uint offset_dst;

    uint stride_src01;
    uint stride_src02;
    uint stride_src03;

    uint stride_src11;
    uint stride_src12;
    uint stride_src13;

    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint ne0;
    uint ne1;
    uint ne2;

    uint ne12;
    uint ne13;

    float scale;
    float max_bias;
    float n_head_log2;
    float m0;
    float m1;

    uint n_rows;
    uint nwg_x;
};

shared float scratch[WG_SIZE];

float mask_val(uint i) {
#if defined(HAS_MASK) && defined(MASK_F16)
    return LOAD_F16(mask, i);
#elif defined(HAS_MASK)
    return LOAD_F32(mask, i);
#else
    return 0.0;
#endif
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint i   = gl_WorkGroupID.y * nwg_x + gl_WorkGroupID.x;
    if (i >= n_rows) {
        return;
    }
    uint i3 = i / (ne2 * ne1);
    i = i % (ne2 * ne1);
    uint i2 = i / ne1;
    uint i1 = i % ne1;
    uint src0_row = offset_src0 + i3 * stride_src03 + i2 * stride_src02 + i1 * stride_src01;
    uint src1_row = offset_src1 + (i3 % ne13) * stride_src13 + (i2 % ne12) * stride_src12 + i1 * stride_src11;
    uint dst_row  = offset_dst + i3 * stride_dst3 + i2 * stride_dst2 + i1 * stride_dst1;

    float head  = float(i2);
    float slope = 1.0;
    if (max_bias > 0.0) {
        slope = head < n_head_log2 ? pow(m0, head + 1.0) : pow(m1, 2.0 * (head - n_head_log2) + 1.0);
    }

#ifdef HAS_SINK
    float max_val = LOAD_F32(sinks, offset_sinks + i2);
#else
    float max_val = -1e30;
#endif
    for (uint col = tid; col < ne0; col += uint(WG_SIZE)) {
        max_val = max(max_val, LOAD_F32(src, src0_row + col) * scale + slope * mask_val(src1_row + col));
    }
    scratch[tid] = max_val;
    barrier();
    for (uint off = uint(WG_SIZE) / 2u; off > 0u; off /= 2u) {
        if (tid < off) {
            scratch[tid] = max(scratch[tid], scratch[tid + off]);
        }
        barrier();
    }
    float row_max = scratch[0];
    barrier();

    // each thread writes and later rereads only its own columns, so no barrier is needed on dst
    float sum = 0.0;
    for (uint c2 = tid; c2 < ne0; c2 += uint(WG_SIZE)) {
        float ex = exp(LOAD_F32(src, src0_row + c2) * scale + slope * mask_val(src1_row + c2) - row_max);
        sum += ex;
        STORE_F32(dst, dst_row + c2, ex);
    }
    scratch[tid] = sum;
    barrier();
    for (uint off2 = uint(WG_SIZE) / 2u; off2 > 0u; off2 /= 2u) {
        if (tid < off2) {
            scratch[tid] += scratch[tid + off2];
        }
        barrier();
    }
    float row_sum = scratch[0];
#ifdef HAS_SINK
    row_sum += exp(LOAD_F32(sinks, offset_sinks + i2) - row_max);
#endif
    float inv = 1.0 / row_sum;
    for (uint c3 = tid; c3 < ne0; c3 += uint(WG_SIZE)) {
        STORE_F32(dst, dst_row + c3, LOAD_F32(dst, dst_row + c3) * inv);
    }
}
