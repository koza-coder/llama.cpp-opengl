#include "common.glsl"

// Port of the D3D11 cpy.hlsl. defines: SRC_{F32,F16,BF16,I32}, DST_{F32,F16,BF16,I32}

#if defined(SRC_F32)
#define SRC_T float
#define LOAD_SRC(i) LOAD_F32(src, i)
#elif defined(SRC_F16)
#define SRC_T float
#define LOAD_SRC(i) LOAD_F16(src, i)
#elif defined(SRC_BF16)
#define SRC_T float
#define LOAD_SRC(i) uintBitsToFloat(((src[(i) >> 1] >> (((i) & 1u) * 16u)) & 0xFFFFu) << 16)
#elif defined(SRC_I32)
#define SRC_T int
#define LOAD_SRC(i) LOAD_I32(src, i)
#endif

#if defined(DST_F32)
#define DST_T float
#define STORE_DST(i, v) STORE_F32(dst, i, v)
#elif defined(DST_F16)
#define DST_T float
#define STORE_DST(i, v) STORE_F16(dst, i, v)
#elif defined(DST_BF16)
#define DST_T float
// f32 -> bf16 as the CPU does (ggml_compute_fp32_to_bf16): NaN stays a quiet NaN, else round to nearest even;
// the half is written with two atomics as STORE_F16 does
uint f32_to_bf16(float f) {
    uint u = floatBitsToUint(f);
    if ((u & 0x7fffffffu) > 0x7f800000u) {
        return (u >> 16) | 64u;
    }
    return (u + (0x7fffu + ((u >> 16) & 1u))) >> 16;
}
#define STORE_DST(i, v) { \
    uint _h  = f32_to_bf16(v); \
    uint _sh = ((i) & 1u) * 16u; \
    atomicAnd(dst[(i) >> 1], ~(0xFFFFu << _sh)); \
    atomicOr(dst[(i) >> 1], _h << _sh); \
}
#elif defined(DST_I32)
#define DST_T int
#define STORE_DST(i, v) STORE_I32(dst, i, v)
#endif

layout(local_size_x = WG_SIZE) in;

layout(std430, binding = 0) buffer Src { uint src[]; };
layout(std430, binding = 1) buffer Dst { uint dst[]; };

layout(std140, binding = 0) uniform Params {
    uint ne;
    uint offset_src;
    uint offset_dst;

    uint stride_src0;
    uint stride_src1;
    uint stride_src2;
    uint stride_src3;

    uint stride_dst0;
    uint stride_dst1;
    uint stride_dst2;
    uint stride_dst3;

    uint src_ne0;
    uint src_ne1;
    uint src_ne2;

    uint dst_ne0;
    uint dst_ne1;
    uint dst_ne2;

    uint nwg_x;
};

void main() {
    uint idx = flat_index(gl_GlobalInvocationID, nwg_x);
    if (idx >= ne) {
        return;
    }

    uint i = idx;
    uint i3 = i / (src_ne2 * src_ne1 * src_ne0);
    i = i % (src_ne2 * src_ne1 * src_ne0);
    uint i2 = i / (src_ne1 * src_ne0);
    i = i % (src_ne1 * src_ne0);
    uint i1 = i / src_ne0;
    uint i0 = i % src_ne0;

    uint j = idx;
    uint j3 = j / (dst_ne2 * dst_ne1 * dst_ne0);
    j = j % (dst_ne2 * dst_ne1 * dst_ne0);
    uint j2 = j / (dst_ne1 * dst_ne0);
    j = j % (dst_ne1 * dst_ne0);
    uint j1 = j / dst_ne0;
    uint j0 = j % dst_ne0;

    uint src_idx = i0 * stride_src0 + i1 * stride_src1 + i2 * stride_src2 + i3 * stride_src3;
    uint dst_idx = j0 * stride_dst0 + j1 * stride_dst1 + j2 * stride_dst2 + j3 * stride_dst3;

    SRC_T v = LOAD_SRC(offset_src + src_idx);
    STORE_DST(offset_dst + dst_idx, DST_T(v));
}
